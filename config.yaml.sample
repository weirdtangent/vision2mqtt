# Example configuration for vision2mqtt
# Copy this file to config.yaml and adjust values as needed.

home_assistant: true               # enable Home Assistant MQTT discovery (forces retain_presence on)

mqtt:
  host: 10.10.10.1               # MQTT broker hostname or IP (Synology w/ Mosquitto)
  port: 1883                     # MQTT port (usually 1883 or 8883 for TLS)
  username: mqtt                 # MQTT username
  password: password             # MQTT password
  qos: 0                         # MQTT QoS level (0, 1, or 2)
  protocol_version: "5"          # MQTT protocol version: 3.1.1/3 or 5
  prefix: vision2mqtt            # MQTT topic prefix
  tls_enabled: false             # Enable TLS for MQTT (true/false)
  tls_ca_cert: /config/ca.crt    # Path to CA certificate (if TLS enabled)
  tls_cert: /config/client.crt   # Path to client certificate (if TLS enabled)
  tls_key: /config/client.key    # Path to client private key (if TLS enabled)
  discovery_prefix: homeassistant  # MQTT discovery prefix for Home Assistant

vision:
  backend: ultralytics           # "axcl" for AX8850 NPU, "ultralytics" for CPU fallback
  model: yolo26n.pt              # model path for axcl (.axmodel), or model name for ultralytics
  subscribe_topics:              # topics to listen for vision requests
    - "+/vision/request"
  labels:                        # simplified labels to report (see labels.py for mapping)
    - person
    - vehicle
    - animal
    - bird
    - package
  min_confidence: 0.45           # minimum confidence threshold for detections
  concurrency: 1                 # number of worker tasks processing the queue
  max_queue: 20                  # max queued vision requests (oldest dropped when full)
  retain_presence: false          # publish retained ON/OFF presence per camera per label
  composites:                    # composite detection types (require person + companion nearby)
    - group                      # 2+ people detected
    - dog_walker                 # person + dog
    - cyclist                    # person + bicycle
    - student                    # person + backpack
    - package_carrier            # person + suitcase/handbag
  debug_save_images: false        # save annotated images to /tmp for debugging
  # cameras:                      # per-camera config overrides (optional, YAML only)
  #   "BIRD_FEEDER_CAM_ID":       # camera ID from blink/source system
  #     mode: feeder              # preset: raises person threshold, lowers bird, infers bird on motion
  #   "NURSERY_CAM_ID":
  #     mode: baby                # preset: lowers person threshold, suppresses outdoor labels
  #   "SHED_CAM_ID":
  #     mode: security            # preset: accepts any detection at very low confidence
  #   "OTHER_CAM_ID":             # or explicit per-label overrides (no preset needed)
  #     min_confidence:
  #       person: 0.90
  #       bird: 0.20
  #     default_label: bird       # assume unclassified motion is this label
